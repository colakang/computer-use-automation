{
  "schema_version": "cua.capability/v1",
  "id": "member.share.open",
  "version": "0.1.0",
  "title": "Open a new share account",
  "description": "Open a new share (sub-account) of a given type for an existing member and return the confirmation. Commits a change on the system of record.",
  "app": {
    "product": "coreone-teller",
    "vendor": "CoreOne Systems",
    "versions": [
      "4.2"
    ],
    "surface": "legacy_web"
  },
  "entry": "/login",
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "Member number (5\u201310 digits)",
      "required": true,
      "pattern": "^\\d{5,10}$",
      "sensitivity": "internal"
    },
    {
      "name": "share_type",
      "type": "enum",
      "description": "Product type of the new share",
      "required": true,
      "enum": [
        "Money Market",
        "Certificate",
        "Holiday Club"
      ],
      "sensitivity": "public"
    },
    {
      "name": "nickname",
      "type": "string",
      "description": "Nickname shown on statements",
      "required": true,
      "sensitivity": "internal"
    },
    {
      "name": "opening_deposit",
      "type": "money",
      "description": "Opening deposit amount",
      "required": true,
      "pattern": "^\\d+(\\.\\d{2})?$",
      "sensitivity": "confidential"
    }
  ],
  "outputs": [
    {
      "name": "new_share_id",
      "type": "string",
      "description": "ID of the newly opened share",
      "sensitivity": "internal"
    },
    {
      "name": "confirmation_number",
      "type": "string",
      "description": "Confirmation number shown after opening",
      "sensitivity": "internal"
    }
  ],
  "outcomes": [
    {
      "condition": "no_records",
      "code": "RECORD_NOT_FOUND",
      "description": "Search or lookup returned nothing."
    },
    {
      "condition": "invalid_member_number",
      "code": "INVALID_INPUT",
      "description": "The app rejected the input format."
    },
    {
      "condition": "form_validation",
      "code": "VALIDATION_ERROR",
      "description": "The app rejected a form submission."
